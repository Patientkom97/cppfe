{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "^/(includes|data)(/.*)?$", "status": 404 },
    { "src": "^/.*\\.(sqlite|md|htaccess)$", "status": 404 },
    { "src": "^/$", "dest": "/api/index.php" },
    { "src": "^/(?!api/)([^/]+/)?[^/]+\\.php$", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
